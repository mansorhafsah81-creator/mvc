@{
    ViewData["Title"] = "حجز القاعة - نظام حجز القاعات";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Cairo', sans-serif;
            }

            body {
                background-color: #f4f6f9;
                display: flex;
                height: 100vh;
                overflow: hidden;
                direction: rtl;
                text-align: right;
            }

            /* القائمة الجانبية في أقصى اليمين */
            .sidebar {
                width: 260px;
                background-color: #071933;
                color: #fff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 20px 0;
                flex-shrink: 0;
            }

            .sidebar-top .user-profile {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 20px 20px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 15px;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                background: #e2e8f0;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #333;
                font-size: 18px;
            }

            .user-info h4 {
                font-size: 14px;
                font-weight: 700;
                color: #fff;
            }

            .user-info span {
                font-size: 11px;
                color: #a0aec0;
            }

            .sidebar-menu {
                list-style: none;
                padding: 0 10px;
            }

                .sidebar-menu li {
                    margin-bottom: 5px;
                }

                .sidebar-menu a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 15px;
                    color: #cbd5e1;
                    text-decoration: none;
                    font-size: 13px;
                    border-radius: 8px;
                    transition: 0.2s;
                }

                    .sidebar-menu a:hover, .sidebar-menu li.active a {
                        background-color: #0b2545;
                        color: #fff;
                    }

            /* المحتوى الرئيسي */
            .main-content {
                flex: 1;
                padding: 25px 30px;
                overflow-y: auto;
                background-color: #f8f9fa;
            }

            .page-header {
                margin-bottom: 5px;
            }

                .page-header h2 {
                    font-size: 20px;
                    font-weight: 700;
                    color: #111;
                }

            .breadcrumb-text {
                font-size: 12px;
                color: #6c757d;
                margin-bottom: 25px;
            }

            .booking-container {
                display: flex;
                gap: 25px;
                align-items: flex-start;
            }

            /* كارت القاعة المصغر في اليسار */
            .hall-preview-card {
                width: 270px;
                background: #fff;
                border-radius: 12px;
                border: 1px solid #e2e8f0;
                overflow: hidden;
                box-shadow: 0 2px 6px rgba(0,0,0,0.02);
                padding: 15px;
                flex-shrink: 0;
            }

            .hall-preview-img {
                width: 100%;
                height: 140px;
                border-radius: 8px;
                overflow: hidden;
                background: #e2e8f0;
                margin-bottom: 12px;
            }

                .hall-preview-img img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .hall-preview-title {
                font-size: 15px;
                font-weight: 700;
                color: #111;
                text-align: center;
                margin-bottom: 4px;
            }

            .hall-preview-location {
                font-size: 12px;
                color: #6c757d;
                text-align: center;
                margin-bottom: 15px;
            }

            .hall-preview-meta {
                display: flex;
                flex-direction: column;
                gap: 10px;
                font-size: 12px;
                color: #4b5563;
                border-top: 1px solid #f1f5f9;
                padding-top: 12px;
            }

                .hall-preview-meta div {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

            /* نموذج إدخال بيانات الحجز في الوسط */
            .booking-form-card {
                flex: 1;
                background: #fff;
                border-radius: 12px;
                border: 1px solid #e2e8f0;
                padding: 25px 35px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            }

            .form-section-title {
                font-size: 15px;
                font-weight: 700;
                color: #111;
                margin-bottom: 20px;
                border-bottom: 1px solid #f1f5f9;
                padding-bottom: 10px;
            }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    color: #334155;
                    margin-bottom: 8px;
                }

            .form-control {
                width: 100%;
                padding: 11px 15px;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                font-size: 13px;
                color: #111;
                outline: none;
                transition: 0.2s;
                background-color: #fff;
            }

                .form-control:focus {
                    border-color: #1e3a8a;
                    box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.1);
                }

            textarea.form-control {
                resize: vertical;
                height: 90px;
            }

            /* زر تأكيد الحجز */
            .submit-btn-container {
                margin-top: 25px;
            }

            .btn-confirm {
                display: block;
                width: 100%;
                padding: 12px;
                background: #1e3a8a;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 700;
                text-align: center;
                text-decoration: none;
                cursor: pointer;
                transition: 0.2s;
            }

                .btn-confirm:hover {
                    opacity: 0.9;
                }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-top">
            <div class="user-profile">
                <div class="user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="user-info">
                    <h4>أحمد محمد</h4>
                    <span>طالب</span>
                </div>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a href="/account/dashboard"><i class="bi bi-house-door"></i> الرئيسية</a>
                </li>
                <li class="active">
                    <a href="/account/halls"><i class="bi bi-grid"></i> القاعات</a>
                </li>
                <li>
                    <a href="/Account/Bookings"><i class="bi bi-calendar-check"></i> حجوزاتي</a>
                </li>
                <li>
                    <a href="#"><i class="bi bi-bell"></i> الإشعارات</a>
                </li>
                <li>
                    <a href="#"><i class="bi bi-person"></i> الملف الشخصي</a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom">
            <ul class="sidebar-menu">
                <li>
                    <a href="/account/login"><i class="bi bi-box-arrow-right"></i> تسجيل خروج</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="main-content">
        <div class="page-header">
            <h2>حجز القاعة</h2>
        </div>
        <div class="breadcrumb-text">القاعات / تفاصيل القاعة / حجز القاعة</div>

        <div class="booking-container">

            <div class="hall-preview-card">
                <div class="hall-preview-img">
                    <img id="previewImg" src="~/images/hall1.jpg" alt="قاعة 101" />
                </div>
                <div class="hall-preview-title" id="previewTitle">قاعة 101</div>
                <div class="hall-preview-location" id="previewLocation"><i class="bi bi-building"></i> مبنى أ - الدور الأول</div>

                <div class="hall-preview-meta">
                    <div><i class="bi bi-calendar-event" style="color: #6c757d;"></i> الأحد 19 مايو 2024</div>
                    <div><i class="bi bi-clock" style="color: #6c757d;"></i> 10:00 - 12:00</div>
                    <div><i class="bi bi-people" style="color: #6c757d;"></i> السعة: 50 شخص</div>
                </div>
            </div>

            <div class="booking-form-card">
                <div class="form-section-title"><i class="bi bi-info-circle"></i> معلومات حجز القاعة الجديدة</div>

                <form asp-controller="Account" asp-action="BookingHall" method="post">
                    <div class="form-group">
                        <label>اسم أو رقم القاعة</label>
                        <select name="hallNumber" id="hallSelect" class="form-control" onchange="updateHallPreview(this)">
                            <option value="قاعة 101" data-building="مبنى A - الدور الأول" data-capacity="50" data-img="hall1.jpg">قاعة 101 (مبنى A)</option>
                            <option value="قاعة 202" data-building="مبنى B - الدور الثاني" data-capacity="60" data-img="hall2.jpg">قاعة 202 (مبنى B)</option>
                            <option value="قاعة 303" data-building="مبنى C - الدور الثالث" data-capacity="100" data-img="hall3.jpg">قاعة 303 (مبنى C)</option>
                            <option value="قاعة 404" data-building="مبنى D - الدور الرابع" data-capacity="60" data-img="hall1.jpg">قاعة 404 (مبنى D)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>اسم المبنى</label>
                        <input type="text" name="buildingName" id="buildingInput" class="form-control" value="مبنى A - الدور الأول" required />
                    </div>

                    <div class="form-group">
                        <label>السعة / عدد الحضور</label>
                        <input type="number" name="attendeesCount" id="capacityInput" class="form-control" placeholder="أدخل السعة" value="50" required />
                    </div>

                    <div class="form-group">
                        <label>اسم صاحب الحجز</label>
                        <input type="text" name="userName" class="form-control" placeholder="أدخل اسمك" value="حفصة منصور" required />
                    </div>

                    <div class="form-group">
                        <label>تاريخ الحجز</label>
                        <input type="text" name="bookingDate" class="form-control" value="@DateTime.Now.ToString("yyyy/MM/dd")" required />
                    </div>

                    <div class="form-group">
                        <label>الغرض من الحجز</label>
                        <select name="purpose" class="form-control" required>
                            <option value="اجتماع">اجتماع</option>
                            <option value="محاضرة">محاضرة</option>
                            <option value="ورشة عمل">ورشة عمل</option>
                            <option value="مناقشة مشروع تخرج">مناقشة مشروع تخرج</option>
                            <option value="ندوة علمية">ندوة علمية</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>القسم</label>
                        <select name="department" class="form-control" required>
                            <option value="علوم الحاسب">علوم الحاسب</option>
                            <option value="تقنية المعلومات">تقنية المعلومات</option>
                            <option value="نظم المعلومات">نظم المعلومات</option>
                            <option value="هندسة البرمجيات">هندسة البرمجيات</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>صورة القاعة</label>
                        <select name="hallImage" id="imageSelect" class="form-control">
                            <option value="assets/hall_101.png">صورة قاعة 101 (الافتراضية)</option>
                            <option value="assets/hall_202.png">صورة قاعة 202</option>
                            <option value="assets/hall_303.png">صورة قاعة 303</option>
                            <option value="assets/hall_404.png">صورة قاعة 404</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>ملاحظات (اختياري)</label>
                        <textarea name="notes" class="form-control" placeholder="أدخل ملاحظات إضافية"></textarea>
                    </div>

                    <div class="submit-btn-container">
                        <button type="submit" class="btn-confirm">تأكيد وحفظ الحجز</button>
                    </div>
                </form>
            </div>

            <script>
                function updateHallPreview(select) {
                    var selected = select.options[select.selectedIndex];
                    document.getElementById('buildingInput').value = selected.getAttribute('data-building') || '';
                    document.getElementById('capacityInput').value = selected.getAttribute('data-capacity') || '50';
                    var img = selected.getAttribute('data-img') || 'hall1.jpg';
                    document.getElementById('previewImg').src = '/images/' + img;
                    document.getElementById('previewTitle').innerText = selected.value;
                    document.getElementById('previewLocation').innerText = selected.getAttribute('data-building') || '';
                }
            </script>

        </div>
    </div>

</body>
</html>


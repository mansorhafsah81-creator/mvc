@model IEnumerable<universityBooking.Application.DTOs.BookingDto>

@{
    ViewData["Title"] = "حجوزاتي - نظام حجز القاعات الجامعية";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #f8f9fa;
            display: flex;
            height: 100vh;
            overflow: hidden;
            direction: rtl;
            text-align: right;
        }

        .sidebar {
            width: 260px;
            background-color: #071933;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px 0;
            flex-shrink: 0;
        }

        .sidebar-top .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px 20px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 15px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: #e2e8f0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
            font-size: 18px;
        }

        .user-info h4 {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
        }

        .user-info span {
            font-size: 11px;
            color: #a0aec0;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0 10px;
        }

        .sidebar-menu li {
            margin-bottom: 5px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 13px;
            border-radius: 8px;
            transition: 0.2s;
        }

        .sidebar-menu a:hover, .sidebar-menu li.active a {
            background-color: #0b2545;
            color: #fff;
        }

        .sidebar-bottom {
            padding: 0 10px;
        }

        .main-content {
            flex: 1;
            padding: 25px 30px;
            overflow-y: auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .page-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #0b2545;
        }

        .btn-new-booking {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: #1e3a8a;
            color: #fff;
            padding: 10px 18px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-new-booking:hover {
            background-color: #172554;
        }

        .table-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: right;
        }

        thead {
            background-color: #f1f5f9;
        }

        th {
            padding: 14px 18px;
            font-size: 13px;
            font-weight: 700;
            color: #475569;
            border-bottom: 1px solid #e2e8f0;
        }

        td {
            padding: 14px 18px;
            font-size: 13px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        tr:hover td {
            background-color: #f8fafc;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-success {
            background-color: #dcfce7;
            color: #166534;
        }

        .badge-pending {
            background-color: #fef3c7;
            color: #92400e;
        }

        .badge-danger {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .btn-delete {
            background: #ef4444;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-delete:hover {
            background: #dc2626;
        }

        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #64748b;
        }

        .empty-state i {
            font-size: 48px;
            color: #94a3b8;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-top">
            <div class="user-profile">
                <div class="user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="user-info">
                    <h4>حفصة منصور</h4>
                    <span>طالبة</span>
                </div>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a href="/Account/Dashboard"><i class="bi bi-house-door"></i> الرئيسية</a>
                </li>
                <li>
                    <a href="/Account/Halls"><i class="bi bi-grid"></i> القاعات</a>
                </li>
                <li class="active">
                    <a href="/Account/Bookings"><i class="bi bi-calendar-check"></i> حجوزاتي</a>
                </li>
                <li>
                    <a href="#"><i class="bi bi-bell"></i> الإشعارات</a>
                </li>
                <li>
                    <a href="#"><i class="bi bi-person"></i> الملف الشخصي</a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom">
            <ul class="sidebar-menu">
                <li>
                    <a href="/Account/Login"><i class="bi bi-box-arrow-right"></i> تسجيل خروج</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="main-content">
        <div class="page-header">
            <div>
                <h2>سجل الحجوزات</h2>
                <span style="font-size: 12px; color: #64748b;">عرض كافة الحجوزات المحفوظة في قاعدة البيانات (سواء من الويب أو تطبيق فلاتر)</span>
            </div>
            <a href="/Account/Details" class="btn-new-booking">
                <i class="bi bi-plus-lg"></i> حجز قاعة جديدة
            </a>
        </div>

        <div class="table-card">
            @if (Model != null && Model.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>القاعة</th>
                            <th>المبنى</th>
                            <th>التاريخ والوقت</th>
                            <th>الغرض</th>
                            <th>صاحب الحجز</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.HallName</strong></td>
                                <td>@item.Building</td>
                                <td>
                                    <div>@item.Date</div>
                                    <small style="color: #64748b;">@item.StartTime - @item.EndTime</small>
                                </td>
                                <td>@item.Purpose</td>
                                <td>@item.UserName</td>
                                <td>
                                    @if (item.Status == "مؤكد")
                                    {
                                        <span class="badge badge-success">مؤكد</span>
                                    }
                                    else if (item.Status == "ملغي")
                                    {
                                        <span class="badge badge-danger">ملغي</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="CancelBooking" method="post" style="display:inline;" onsubmit="return confirm('هل أنت متأكد من رغبتك في إلغاء هذا الحجز؟');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-delete">
                                            <i class="bi bi-trash"></i> إلغاء
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h3>لا توجد حجوزات مسجلة حالياً</h3>
                    <p>قم بإضافة حجز جديد من نموذج الحجز أو من تطبيق فلاتر ليظهر هنا فوراً.</p>
                </div>
            }
        </div>
    </div>

</body>
</html>

@{
    ViewData["Title"] = "إنشاء حساب جديد - نظام حجز القاعات الجامعية";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #f4f6f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            direction: rtl;
            text-align: right;
        }

        .register-container {
            display: flex;
            width: 900px;
            min-height: 560px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .register-image-side {
            flex: 1;
            position: relative;
            background: #071933;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #fff;
            padding: 40px;
            text-align: center;
        }

        .register-image-side img {
            width: 80%;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .register-form-side {
            flex: 1.2;
            padding: 40px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .register-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .register-header h2 {
            font-size: 20px;
            font-weight: 700;
            color: #0b2545;
        }

        .register-header p {
            font-size: 12px;
            color: #64748b;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            font-size: 12px;
            color: #334155;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .input-box {
            position: relative;
        }

        .input-box input {
            width: 100%;
            padding: 10px 15px 10px 40px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 13px;
            outline: none;
            transition: 0.2s;
            background: #fff;
        }

        .input-box input:focus {
            border-color: #1e3a8a;
            box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.1);
        }

        .input-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #888;
            font-size: 14px;
        }

        .submit-btn {
            width: 100%;
            padding: 11px;
            background: #0b2545;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        .submit-btn:hover {
            background: #1e3a8a;
        }

        .login-link {
            text-align: center;
            font-size: 12px;
            color: #64748b;
        }

        .login-link a {
            color: #1e3a8a;
            text-decoration: none;
            font-weight: 700;
        }

        .alert-error {
            background-color: #fee2e2;
            color: #b91c1c;
            padding: 10px;
            border-radius: 8px;
            font-size: 12px;
            margin-bottom: 15px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="register-container">
        <!-- الجانب الأيمن للمعلومات والصورة -->
        <div class="register-image-side">
            <img src="/images/1.jpg" alt="جامعة" onerror="this.style.display='none';" />
            <h3 style="font-size: 18px; margin-bottom: 8px;">مرحباً بك في منصتنا</h3>
            <p style="font-size: 12px; color: #cbd5e1; line-height: 1.6;">
                سجل حسابك الآن لتتمكن من استعراض وحجز القاعات الجامعية بكل سهولة ومتابعة حالة حجوزاتك بشكل فوري.
            </p>
        </div>

        <!-- الجانب الأيسر للنموذج -->
        <div class="register-form-side">
            <div class="register-header">
                <div style="font-size: 28px; color: #0b2545; margin-bottom: 6px;"><i class="bi bi-person-plus-fill"></i></div>
                <h2>إنشاء حساب جديد</h2>
                <p>أدخل بياناتك للانضمام إلى نظام حجز القاعات</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
                </div>
            }

            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="form-group">
                    <label>الاسم الكامل</label>
                    <div class="input-box">
                        <input type="text" name="fullName" placeholder="مثال: حفصة منصور" required />
                        <i class="bi bi-person"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label>البريد الإلكتروني الجامعي</label>
                    <div class="input-box">
                        <input type="email" name="email" placeholder="example@university.edu" required />
                        <i class="bi bi-envelope"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label>كلمة المرور</label>
                    <div class="input-box">
                        <input type="password" name="password" placeholder="أدخل كلمة المرور" required />
                        <i class="bi bi-lock"></i>
                    </div>
                </div>

                <div class="form-group">
                    <label>تأكيد كلمة المرور</label>
                    <div class="input-box">
                        <input type="password" name="confirmPassword" placeholder="أعد إدخال كلمة المرور" required />
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>

                <button type="submit" class="submit-btn">إنشاء الحساب والبدء</button>

                <div class="login-link">
                    لديك حساب بالفعل؟ <a href="/Account/Login">تسجيل الدخول</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
